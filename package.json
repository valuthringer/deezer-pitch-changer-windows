{
  "name": "deezer-pitch-changer",
  "version": "1.0.0",
  "description": "Adds speed and pitch controls to the Deezer Desktop app for Windows.",
  "private": true,
  "license": "MIT",
  "author": "Valentin Luthringer",
  "repository": {
    "type": "git",
    "url": "https://github.com/valuthringer/deezer-pitch-changer-windows.git"
  },
  "bin": {
    "deezer-pitch-changer": "src/cli.js"
  },
  "scripts": {
    "inject": "node src/cli.js install",
    "restore": "node src/cli.js uninstall",
    "status": "node src/cli.js status",
    "test": "node --test",
    "build": "node scripts/build.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "devDependencies": {
    "postject": "1.0.0-alpha.6",
    "rcedit": "4.0.1"
  }
}
